{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Net migration (arrivals minus departures) by visa class, 2024-25. Diverging bar with positive and negative flows. Sorted from largest net inflow at the top to largest net outflow at the bottom.",
  "width": "container",
  "height": 380,
  "background": "transparent",
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter Tight, sans-serif",
      "titleFont": "Inter Tight, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#5a5145",
      "titleColor": "#2a2a2a",
      "grid": true,
      "gridColor": "#ece3d4",
      "domainColor": "#d8cdb8",
      "tickColor": "#d8cdb8"
    },
    "font": "Inter Tight, sans-serif"
  },
  "data": {
    "values": [
      {
        "visa": "Student - higher education",
        "arrivals": 126270,
        "departures": 28640,
        "net": 97630
      },
      {
        "visa": "Working holiday",
        "arrivals": 78340,
        "departures": 24950,
        "net": 53390
      },
      {
        "visa": "New Zealand citizens (subclass 444)",
        "arrivals": 53020,
        "departures": 14730,
        "net": 38290
      },
      {
        "visa": "Visitors",
        "arrivals": 56080,
        "departures": 18340,
        "net": 37740
      },
      {
        "visa": "Skilled (temporary)",
        "arrivals": 45780,
        "departures": 10080,
        "net": 35700
      },
      {
        "visa": "Skilled (permanent)",
        "arrivals": 40410,
        "departures": 5200,
        "net": 35210
      },
      {
        "visa": "Family",
        "arrivals": 24390,
        "departures": 4840,
        "net": 19550
      },
      {
        "visa": "Special eligibility & humanitarian",
        "arrivals": 14870,
        "departures": 180,
        "net": 14690
      },
      {
        "visa": "Student - other",
        "arrivals": 21750,
        "departures": 8020,
        "net": 13730
      },
      {
        "visa": "Other (permanent)",
        "arrivals": 8540,
        "departures": 8410,
        "net": 130
      },
      {
        "visa": "Student - vocational education and training",
        "arrivals": 8690,
        "departures": 11980,
        "net": -3290
      },
      {
        "visa": "Australian citizens (no visa)",
        "arrivals": 64060,
        "departures": 81510,
        "net": -17450
      },
      {
        "visa": "Other (temporary)",
        "arrivals": 26170,
        "departures": 45920,
        "net": -19750
      }
    ]
  },
  "transform": [
    {
      "calculate": "datum.net >= 0 ? 'Net inflow' : 'Net outflow'",
      "as": "direction"
    }
  ],
  "encoding": {
    "y": {
      "field": "visa",
      "type": "nominal",
      "sort": [
        "Student - higher education",
        "Working holiday",
        "New Zealand citizens (subclass 444)",
        "Visitors",
        "Skilled (temporary)",
        "Skilled (permanent)",
        "Family",
        "Special eligibility & humanitarian",
        "Student - other",
        "Other (permanent)",
        "Student - vocational education and training",
        "Australian citizens (no visa)",
        "Other (temporary)"
      ],
      "axis": {
        "title": null,
        "labelLimit": 240,
        "orient": "right",
        "labelPadding": 8
      }
    },
    "x": {
      "field": "net",
      "type": "quantitative",
      "scale": {"domain": [-25000, 130000]},
      "axis": {
        "title": "Net migration (arrivals − departures)",
        "format": ",.0f"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3,
        "height": 16
      },
      "encoding": {
        "color": {
          "field": "direction",
          "type": "nominal",
          "scale": {
            "domain": [
              "Net inflow",
              "Net outflow"
            ],
            "range": [
              "#1e5f74",
              "#c14a26"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "visa",
            "type": "nominal",
            "title": "Visa class"
          },
          {
            "field": "arrivals",
            "type": "quantitative",
            "title": "Arrivals",
            "format": ","
          },
          {
            "field": "departures",
            "type": "quantitative",
            "title": "Departures",
            "format": ","
          },
          {
            "field": "net",
            "type": "quantitative",
            "title": "Net",
            "format": "+,"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "baseline": "middle",
        "fontSize": 11,
        "color": "#2a2a2a",
        "fontWeight": 500,
        "align": {
          "expr": "datum.net >= 0 ? 'left' : 'right'"
        },
        "dx": {
          "expr": "datum.net >= 0 ? 6 : -6"
        }
      },
      "encoding": {
        "text": {
          "field": "net",
          "type": "quantitative",
          "format": "+,"
        }
      }
    }
  ]
}