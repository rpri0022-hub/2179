    "type": "area",
    "interpolate": "monotone",
    "opacity": 0.92
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "axis": {
        "title": null,
        "labelExpr": "isNumber(datum.value) && datum.value > 2000 && datum.value % 3 === 1 ? datum.value + '-' + slice(toString(datum.value + 1), 2, 4) : ''",
        "labelAngle": -40
      }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "stack": "zero",
      "axis": {
        "title": "Arrivals (persons)",
        "format": ",.0f"
      }
    },
    "color": {
      "field": "category",
      "type": "nominal",
