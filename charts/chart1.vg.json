{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Total Net Overseas Migration to Australia, 2004-05 to 2024-25. Hero chart showing the COVID collapse and unprecedented rebound.",
  "width": "container",
  "height": 360,
  "background": "transparent",
  "config": {
    "view": {"stroke": null},
    "axis": {
      "labelFont": "Inter Tight, sans-serif",
      "titleFont": "Inter Tight, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelColor": "#5a5145",
      "titleColor": "#2a2a2a",
      "grid": true,
      "gridColor": "#ece3d4",
      "domainColor": "#d8cdb8",
      "tickColor": "#d8cdb8"
    },
    "font": "Inter Tight, sans-serif"
  },
  "data": {
    "values": [
      {"year": 2004, "value": 142580},
      {"year": 2005, "value": 171840},
      {"year": 2006, "value": 232800},
      {"year": 2007, "value": 277340},
      {"year": 2008, "value": 299870},
      {"year": 2009, "value": 196060},
      {"year": 2010, "value": 180370},
      {"year": 2011, "value": 231950},
      {"year": 2012, "value": 230330},
      {"year": 2013, "value": 187780},
      {"year": 2014, "value": 184030},
      {"year": 2015, "value": 206230},
      {"year": 2016, "value": 263350},
      {"year": 2017, "value": 238220},
      {"year": 2018, "value": 241340},
      {"year": 2019, "value": 192700},
      {"year": 2020, "value": -84940},
      {"year": 2021, "value": 207910},
      {"year": 2022, "value": 538340},
      {"year": 2023, "value": 429160},
      {"year": 2024, "value": 305570}
    ]
  },
  "transform": [
    {"calculate": "datum.year + '-' + slice(toString(datum.year + 1), 2, 4)", "as": "fy"}
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "scale": {"domain": [2004, 2024], "nice": false},
      "axis": {
        "orient": "bottom",
        "title": null,
        "values": [2004, 2005, 2006, 2007, 2008, 2009, 2010, 2011, 2012, 2013, 2014, 2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024],
        "labelExpr": "datum.value + '-' + slice(toString(datum.value + 1), 2, 4)",
        "labelAngle": -40
      }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "scale": {"domain": [-120000, 620000]},
      "axis": {
        "title": "Net Overseas Migration (persons)",
        "format": ",.0f",
        "tickCount": 6
      }
    }
  },
  "layer": [
    {
      "data": {
        "values": [
          {"x_start": 2019, "x_end": 2021}
        ]
      },
      "mark": {
        "type": "rect",
        "color": "#5a5145",
        "opacity": 0.12
      },
      "encoding": {
        "x":  {"field": "x_start", "type": "quantitative"},
        "x2": {"field": "x_end"},
        "y":  {"value": 0},
        "y2": {"value": 360}
      }
    },
    {
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "color": {
          "x1": 1, "y1": 1, "x2": 1, "y2": 0,
          "gradient": "linear",
          "stops": [
            {"offset": 0, "color": "#c14a26", "opacity": 0.0},
            {"offset": 1, "color": "#c14a26", "opacity": 0.25}
          ]
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "interpolate": "monotone",
        "color": "#c14a26",
        "strokeWidth": 2.5
      }
    },
    {
      "mark": {"type": "point", "filled": true, "color": "#c14a26", "size": 55},
      "encoding": {
        "tooltip": [
          {"field": "fy", "type": "nominal", "title": "Year"},
          {"field": "value", "type": "quantitative", "title": "Net migration", "format": ","}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"x": 2020, "y": -84940, "x2": 2017.5, "y2": -84940},
          {"x": 2022, "y": 538340, "x2": 2022, "y2": 600000}
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#1a1a1a",
        "strokeWidth": 1
      },
      "encoding": {
        "x":  {"field": "x",  "type": "quantitative"},
        "x2": {"field": "x2"},
        "y":  {"field": "y",  "type": "quantitative"},
        "y2": {"field": "y2"}
      }
    },
    {
      "data": {
        "values": [
          {"x": 2014, "y": -84940, "label": "COVID border closures", "align": "right"},
          {"x": 2020, "y": 610000, "label": "Record post-pandemic rebound", "align": "center"}
        ]
      },
      "mark": {
        "type": "text",
        "fontStyle": "italic",
        "fontSize": 11,
        "color": "#1a1a1a",
        "fontWeight": 500
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"field": "label"},
        "align": {"field": "align", "type": "nominal"}
      }
    },
    {
      "data": {"values": [{"y": 0}]},
      "mark": {"type": "rule", "color": "#8b7e6c", "strokeDash": [3, 3]},
      "encoding": {"y": {"field": "y", "type": "quantitative"}}
    }
  ]
}