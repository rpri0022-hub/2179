{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Slope chart comparing pre-COVID and post-COVID three-year averages for the top 8 source countries.",
  "width": "container",
  "height": 460,
  "background": "transparent",
  "padding": {"left": 10, "right": 10, "top": 20, "bottom": 20},
  "config": {
    "view": {"stroke": null},
    "axis": {
      "labelFont": "Inter Tight, sans-serif",
